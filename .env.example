NODE_ENV=production
HOST=0.0.0.0
TRUST_PROXY=true

# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD_OF_AT_LEAST_14_CHARACTERS
ADMIN_DISPLAY_NAME=Administrador

APPRENTICE_USERNAME=aprendiz
APPRENTICE_PASSWORD=REPLACE_WITH_A_DIFFERENT_PASSWORD_OF_AT_LEAST_14_CHARACTERS
APPRENTICE_DISPLAY_NAME=Funcionario Aprendiz

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=centro_tramites_daniel
DB_USER=facturador_app
DB_PASSWORD=REPLACE_WITH_A_MYSQL_USER_PASSWORD
# Configure this path to the Aiven CA certificate file. In Render, add it as a Secret File.
DB_SSL_CA_PATH=/etc/secrets/aiven-ca.pem
